# Server-only Google OAuth configuration. Never prefix secrets with VITE_.
ADMIN_PUBLIC_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# At least 32 random bytes; generate with crypto.randomBytes(32).toString('base64url').
ADMIN_SESSION_SECRET=
# Comma-separated exact Google email addresses permitted to access admin.
ADMIN_EMAIL_ALLOWLIST=
# Google Cloud OAuth client type: Web application.
# Authorized redirect URI for this origin:
# http://localhost:5173/api/admin/auth/callback
# Local Vite allows HTTP loopback automatically. Use HTTPS for production.
